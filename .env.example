# Copy to .env.local for local development. NEVER commit real values (.env* is git-ignored).
# On Vercel, set these as project environment variables.

# --- AI (Google Gemini, free tier). Create a key in Google AI Studio. ---
GEMINI_API_KEY=

# --- Shared cache / lock / rate-limit store (Upstash Redis, Vercel Marketplace). ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional US-only quote fallbacks (PLAN §2, tested in Step 1). ---
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# --- Optional shared "club code" gate in front of /api (PLAN §10 Q9). Empty = gate off. ---
CLUB_CODE=

# --- Data source switch for the UI's data-access layer (lib/data): "fixtures" or "live". ---
NEXT_PUBLIC_DATA_MODE=fixtures
