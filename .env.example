# Copy to .env.local for local development. NEVER commit real values (.env* is git-ignored).
# On Vercel, set these as project environment variables.

# --- AI (Google Gemini, free tier). Create a key in Google AI Studio. ---
GEMINI_API_KEY=

# --- Shared cache / lock / rate-limit store (Upstash Redis, Vercel Marketplace). ---
# Holds: data cache + stale copy, request-coalescing lock, Yahoo cookie/crumb, rate-limit counters.
# Leave BOTH empty to use an in-memory store (fine locally and in tests; on Vercel it is per
# instance, so /api/health reports it as "degraded"). One variable alone is ignored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- API guard (Step 2). ---
# Extra hosts allowed by the Origin/Referer check, comma-separated (the site's own host and
# Vercel's VERCEL_URL are always allowed). Example: https://stocklens-beryl.vercel.app
ALLOWED_ORIGINS=

# --- Optional US-only quote fallbacks (PLAN §2, tested in Step 1). ---
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# --- Optional shared "club code" gate in front of /api (PLAN §10 Q9). Empty = gate off. ---
# When set, /api/stock|chart|search need the cookie that POST /api/club {code} sets.
# The weekly smoke script reads this variable to send the cookie.
CLUB_CODE=

# --- Data source switch for the UI's data-access layer (lib/data): "fixtures" or "live". ---
NEXT_PUBLIC_DATA_MODE=fixtures
